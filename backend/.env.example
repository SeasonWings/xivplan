# 数据库配置
DB_HOST=example.site
DB_USER=xivplan
DB_PASSWORD=example
DB_NAME=xivplan
DB_PORT=3306

# 邮件服务配置
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=false
EMAIL_USER=example@foxmail.com
EMAIL_PASS=example

# JWT密钥配置
JWT_SECRET=your_jwt_secret_key

# 服务器配置
PORT=3000
NODE_ENV=development

# 光标活动时间配置
# 单位：毫秒
# 光标在没有移动时保持活动状态的时间
CURSOR_ACTIVE_MS=1000

# 跨域配置
# 多个域名用逗号分隔，使用 * 允许所有域名（仅开发环境）
# 示例：
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-domain.com